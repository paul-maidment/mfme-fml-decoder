<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MfmeFmlDecoder</RootNamespace>
    <AssemblyName>MfmeFmlDecoder</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MfmeFmlDecoder.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FmlTagEdit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ScanEffects</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="src\Decoder\Core\**" />
    <Compile Remove="test/**/*.cs" />
    <Compile Remove="src/**/*Tests.cs" />
    <Compile Remove="tools/**" />
    <Compile Remove="_tmp_scan_effects/**" />
    <Compile Remove="test\smoke_test\MaygayVideo\WithAngle\**" />
    <Compile Remove="test\smoke_test\PlasmaDisplay\WithAngle\**" />
    <EmbeddedResource Remove="src\Decoder\Core\**" />
    <EmbeddedResource Remove="tools/**" />
    <EmbeddedResource Remove="_tmp_scan_effects/**" />
    <None Remove="tools/**" />
    <None Remove="_tmp_scan_effects/**" />

    <Folder Include="test\smoke_test\AceVideo\WithoutAngle\" />
    <Folder Include="test\smoke_test\Alpha\WithoutAngle\" />
    <Folder Include="test\smoke_test\AstraMatrix\WithoutAngle\" />
    <Folder Include="test\smoke_test\BarcrestBwbVideo\WithAngle\" />
    <Folder Include="test\smoke_test\BFMAlpha\WithoutAngle\" />
    <Folder Include="test\smoke_test\BFMColourLed\WithoutAngle\" />
    <Folder Include="test\smoke_test\BFMLed\WithoutAngle\" />
    <Folder Include="test\smoke_test\BFMVideo\WithAngle\" />
    <Folder Include="test\smoke_test\BFMVideo\WithoutAngle\" />
    <Folder Include="test\smoke_test\Bitmap\WithoutAngle\" />
    <Folder Include="test\smoke_test\Checkbox\WithoutAngle\" />
    <Folder Include="test\smoke_test\DotAlpha\WithoutAngle\" />
    <Folder Include="test\smoke_test\DotMatrix\WithAngle\" />
    <Folder Include="test\smoke_test\EpochDotAlpha\WithoutAngle\" />
    <Folder Include="test\smoke_test\EpochMatrix\WithoutAngle\" />
    <Folder Include="test\smoke_test\Frame\WithAngle\" />
    <Folder Include="test\smoke_test\IGTVfd\WithoutAngle\" />
    <Folder Include="test\smoke_test\Label\WithAngle\" />
    <Folder Include="test\smoke_test\Led\WithoutAngle\" />
    <Folder Include="test\smoke_test\MatrixAlpha\WithoutAngle\" />
    <Folder Include="test\smoke_test\MaygayMatrix\WithoutAngle\" />
    <Folder Include="test\smoke_test\ProconnMatrix\WithoutAngle\" />
    <Folder Include="test\smoke_test\RgbLed\WithoutAngle\" />
    <None Remove="src\Decoder\Core\**" />
    <None Remove="test\smoke_test\MaygayVideo\WithAngle\**" />
    <None Remove="test\smoke_test\PlasmaDisplay\WithAngle\**" />
  </ItemGroup>
</Project>
